rules_version = '2';

// Reglas del prototipo Red CAPS (datos FICTICIOS de demostración).
// Sólo usuarios autenticados (ingreso anónimo de Firebase) y sólo las colecciones
// que usa la app. Para datos reales de pacientes hace falta autenticación por rol
// y matrícula (Mi Argentina / RENAPER) y reglas por efector: ver README.
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    match /{coleccion}/{id} {
      allow read, write: if autenticado() && coleccion in [
        'pacientes', 'cupos', 'derivaciones', 'controles',
        'encuentros', 'problemas', 'medicacion', 'accesos'
      ];
    }

    match /sistema/red-caps {
      allow read, write: if autenticado();
    }
  }
}
